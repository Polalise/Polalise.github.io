---
const path = Astro.url.pathname;
const isHome = path === "/";
const isProjects = path.startsWith("/projects/");
const isResume = path === "/resume/";
---

<header class="site-header">
  <div class="header-inner">
    <div class="wordmark">
      <span aria-hidden="true">P</span>
      <strong>Polalise</strong>
    </div>
    <nav aria-label="주요 탐색">
      <a href="/" aria-current={isHome ? "page" : undefined}>소개</a>
      <a href="/projects/" aria-current={isProjects ? "page" : undefined}>프로젝트</a>
      <a href="/resume/" aria-current={isResume ? "page" : undefined}>이력서</a>
    </nav>
    {/* DSN-20260829-003 A2 (WCAG 4.1.2 / 4.1.3). 토글 버튼은 "무엇을 켜고 끄는가" 를
        고정 이름으로 갖고 on/off 는 aria-pressed 로만 알린다. 이전에는 이름이 행동형
        ("라이트 모드로 전환") 이면서 aria-pressed 까지 있어 "전환, pressed" 로 모순됐고,
        상시 aria-live 가 로드마다 잉여 낭독을 냈다. */}
    <button class="theme-toggle" type="button" aria-pressed="false">
      <span>다크 모드</span>
      {/* 모바일에서는 버튼 폭이 좁아 글자가 font-size:0 으로 감춰지고 아이콘만 보인다.
          가시 텍스트는 접근성 트리에는 남아 버튼 이름이 된다. 아이콘은 aria-hidden. */}
      <svg class="theme-toggle__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="M8 1a7 7 0 0 0 0 14z" fill="currentColor" />
      </svg>
    </button>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(".theme-toggle");

  // 이름("다크 모드")은 고정이고 aria-pressed 만 현재 테마를 반영한다.
  const syncPressed = () => {
    if (!button) return;
    button.setAttribute("aria-pressed", String(document.documentElement.dataset.theme === "dark"));
  };

  syncPressed();
  button?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("portfolio-theme", next);
    syncPressed();
  });
</script>
