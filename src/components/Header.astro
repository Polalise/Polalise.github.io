<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label="유병현 포트폴리오 홈">
      <span aria-hidden="true">P</span>
      <strong>Polalise</strong>
    </a>
    <nav aria-label="주요 탐색">
      <a href="/#featured">대표 작업</a>
      <a href="/projects/">전체 프로젝트</a>
      <a href="/resume/">이력서</a>
    </nav>
    <button class="theme-toggle" type="button" aria-label="색상 테마 전환" aria-live="polite">
      <span data-theme-label>테마</span>
    </button>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const label = button?.querySelector<HTMLElement>("[data-theme-label]");

  const updateLabel = () => {
    if (!label) return;
    label.textContent = document.documentElement.dataset.theme === "dark" ? "라이트" : "다크";
  };

  updateLabel();
  button?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("portfolio-theme", next);
    updateLabel();
  });
</script>
