---
import { projectVisualMedia } from "../lib/media";
import Eyebrow from "./Eyebrow.astro";

interface Visual {
  id: string;
  alt: string;
  caption: string;
  scope: "personal" | "team";
  evidence: string;
}

interface Props {
  slug: string;
  visuals: Visual[];
}

const { slug, visuals } = Astro.props;
---

{visuals.length > 0 && (
  <section class="project-gallery" aria-labelledby="project-gallery-title">
    <header class="project-gallery__head" data-reveal>
      <Eyebrow>Selected evidence</Eyebrow>
      <h2 id="project-gallery-title">화면과 평가 근거</h2>
      <p>실제 구현 화면과 집계 그래프만 선별했습니다. 개인 기여와 팀 전체 산출물은 각 캡션에서 구분합니다.</p>
    </header>
    <div class="project-gallery__grid">
      {visuals.map((visual, index) => {
        const media = projectVisualMedia(slug, visual.id);
        return (
          <figure class:list={["project-visual", { "project-visual--lead": index === 0 }]} data-reveal>
            <picture>
              <source srcset={media.srcset} sizes={index === 0 ? "(min-width: 80rem) 72rem, 92vw" : "(min-width: 64rem) 44vw, 92vw"} type="image/webp" />
              <img src={media.src} width={media.width} height={media.height} alt={visual.alt} loading="lazy" decoding="async" />
            </picture>
            <figcaption>
              <span>{visual.scope === "personal" ? "개인 구현·분석" : "팀 산출물"}</span>
              <strong>{visual.caption}</strong>
              <small>근거: {visual.evidence}</small>
            </figcaption>
          </figure>
        );
      })}
    </div>
  </section>
)}
