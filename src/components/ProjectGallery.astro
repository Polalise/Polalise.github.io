---
import { projectVisualMedia } from "../lib/media";
import Eyebrow from "./Eyebrow.astro";
import ImageViewer from "./ImageViewer.astro";

interface Visual {
  id: string;
  alt: string;
  caption: string;
  scope: "personal" | "team";
  evidence: string;
}

interface Props {
  slug: string;
  visuals: Visual[];
}

const { slug, visuals } = Astro.props;
---

{visuals.length > 0 && (
  <section class="project-gallery" id="evidence" aria-labelledby="project-gallery-title">
    <header class="project-gallery__head" data-reveal>
      <Eyebrow>Selected evidence</Eyebrow>
      <h2 id="project-gallery-title">화면과 평가 근거</h2>
      <p>화면마다 기여 범위를 먼저 표시하고, 자세한 출처는 근거 보기를 펼쳐 확인할 수 있습니다.</p>
    </header>
    <div class="project-gallery__grid">
      {visuals.map((visual, index) => {
        const media = projectVisualMedia(slug, visual.id);
        return (
          <figure class:list={["project-visual", { "project-visual--lead": index === 0 }]} data-reveal>
            <a
              class="project-visual__open"
              href={media.src}
              aria-label={`${visual.caption} 크게 보기`}
              data-image-viewer-trigger
              data-viewer-src={media.src}
              data-viewer-alt={visual.alt}
              data-viewer-caption={visual.caption}
              data-viewer-scope={visual.scope === "personal" ? "개인 구현·분석" : "팀 산출물"}
              data-viewer-evidence={visual.evidence}
            >
              <picture>
                <source srcset={media.srcset} sizes={index === 0 ? "(min-width: 80rem) 72rem, 92vw" : "(min-width: 64rem) 44vw, 92vw"} type="image/webp" />
                <img src={media.src} width={media.width} height={media.height} alt={visual.alt} loading="lazy" decoding="async" />
              </picture>
              <span class="project-visual__hint" aria-hidden="true">확대 보기 ↗</span>
            </a>
            <figcaption>
              <span class="evidence-id" aria-hidden="true">V{String(index + 1).padStart(2, "0")}</span>
              <small class="scope-badge">{visual.scope === "personal" ? "개인 구현·분석" : "팀 산출물"}</small>
              <strong>{visual.caption}</strong>
              <details class="evidence-disclosure">
                <summary>근거 보기</summary>
                <small>{visual.evidence}</small>
              </details>
            </figcaption>
          </figure>
        );
      })}
    </div>
    <ImageViewer />
  </section>
)}
