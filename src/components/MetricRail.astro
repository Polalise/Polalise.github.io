---
interface Metric {
  value: string;
  label: string;
  scope: "personal" | "team";
  evidence: string;
}

interface Props {
  metrics: Metric[];
}

const { metrics } = Astro.props;
---

{metrics.length > 0 && (
  <dl class="metric-rail">
    {metrics.map((metric) => (
      <div class="metric-item">
        <dt>{metric.label}</dt>
        <dd>
          <strong>{metric.value}</strong>
          <span>{metric.scope === "personal" ? "개인 결과" : "팀 전체"}</span>
          <small>{metric.evidence}</small>
        </dd>
      </div>
    ))}
  </dl>
)}
