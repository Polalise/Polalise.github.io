---
import type { CollectionEntry } from "astro:content";
import { projectImageSrcSet } from "../lib/media";

interface Props {
  project: CollectionEntry<"projects">;
  variant?: "wide" | "standard" | "compact";
  eager?: boolean;
}

const { project, variant = "standard", eager = false } = Astro.props;
const { data } = project;
---

<article class:list={["project-card", `project-card--${variant}`, `tone-${data.coverTone}`]} data-reveal>
  <a class="project-card__visual" href={`/projects/${project.id}/`} aria-label={`${data.displayTitle} 상세 보기`}>
    <img
      src={data.cover}
      srcset={projectImageSrcSet(data.cover)}
      sizes="(max-width: 48rem) calc(100vw - 2.3rem), (max-width: 64rem) calc(100vw - 4rem), 50vw"
      alt={data.coverAlt}
      width="1600"
      height="1000"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
    />
  </a>
  <div class="project-card__body">
    <div class="project-meta">
      <span>{data.category}</span>
      <span>{data.ownership === "personal" ? "개인 프로젝트" : "팀 프로젝트"}</span>
    </div>
    <h3><a href={`/projects/${project.id}/`}>{data.displayTitle}</a></h3>
    <p>{data.summary}</p>
    {data.metrics[0] && (
      <p class="project-card__metric">
        <strong>{data.metrics[0].value}</strong>
        <span>{data.metrics[0].label}</span>
        <small>{data.metrics[0].scope === "personal" ? "개인 결과" : "팀 전체"}</small>
      </p>
    )}
    <a class="text-link" href={`/projects/${project.id}/`}>사례 보기 <span aria-hidden="true">→</span></a>
  </div>
</article>
