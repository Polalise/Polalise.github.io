---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: "website" | "article";
  canonicalPath?: string;
}

const {
  title = "유병현 | AI 연동형 풀스택 개발자",
  description = "화면부터 API와 데이터베이스 스키마, AI 연동까지 직접 설계하고 검증하는 풀스택 개발자 유병현의 포트폴리오입니다.",
  image = "/media/og/portfolio.webp",
  imageAlt = description,
  imageWidth = 1200,
  imageHeight = 630,
  type = "website",
  canonicalPath
} = Astro.props;

const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "유병현",
  alternateName: "Polalise",
  url: "https://polalise.github.io",
  sameAs: ["https://github.com/Polalise"],
  jobTitle: "AI 연동형 풀스택 개발자",
  knowsAbout: ["React", "Spring Boot", "Python", "LLM", "RAG", "Machine Learning"]
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- 본문 폰트는 CSS 를 파싱해야 발견되므로 요청이 늦다. 첫 진입에서 fallback 의
         차단 구간 안에 받으려면 HTML 파싱 시점에 요청을 시작해야 한다.
         crossorigin 은 폰트가 CORS 모드로 받아지기 때문에 필요하다. 빼면 preload 와
         실제 요청이 서로 다른 캐시 항목이 되어 81KB 를 두 번 받는다. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/pretendard-subset/PretendardVariable.subset.woff2"
      crossorigin
    />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("portfolio-theme");
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = saved || (systemDark ? "dark" : "light");
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.classList.add("reveal-ready");
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 이동</a>
    <Header />
    {/* DSN-20260829-003 A4 (WCAG 2.4.11 / 2.4.1). skip-link 이 여기로 이동할 때
        포커스가 실제로 옮겨지도록 tabindex="-1" 을 둔다. sticky 헤더 가림은
        global.css 의 html { scroll-padding-top } 이 처리하고, 프로그램적 포커스라
        #main-content:focus 는 링을 그리지 않는다. */}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      const revealItems = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let observer: IntersectionObserver | null = null;

      const showAll = () => {
        observer?.disconnect();
        observer = null;
        document.documentElement.classList.remove("reveal-ready");
        revealItems.forEach((item) => item.dataset.visible = "true");
      };

      const observeRemaining = () => {
        if (!("IntersectionObserver" in window)) {
          showAll();
          return;
        }
        document.documentElement.classList.add("reveal-ready");
        observer?.disconnect();
        observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            (entry.target as HTMLElement).dataset.visible = "true";
            observer?.unobserve(entry.target);
          });
        }, { threshold: 0.14 });
        revealItems
          .filter((item) => item.dataset.visible !== "true")
          .forEach((item) => observer?.observe(item));
      };

      const applyMotionPreference = () => {
        if (reducedMotion.matches) showAll();
        else observeRemaining();
      };

      applyMotionPreference();
      reducedMotion.addEventListener("change", applyMotionPreference);
    </script>
  </body>
</html>
