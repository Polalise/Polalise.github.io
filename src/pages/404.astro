---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
---

<BaseLayout title="페이지를 찾을 수 없습니다 | 유병현" description="요청한 페이지를 찾을 수 없습니다." canonicalPath="/404.html">
  <section class="page-shell hero" aria-labelledby="not-found-title">
    <div class="hero-copy">
      <Eyebrow>404 / Not found</Eyebrow>
      <h1 id="not-found-title">이 페이지는 연결되지 않았습니다.</h1>
      <p class="hero-lead">프로젝트 목록에서 공개된 작업을 다시 찾아볼 수 있습니다.</p>
      <div class="button-row hero-actions">
        <Button href="/projects/">프로젝트 목록</Button>
        <Button variant="ghost" href="/">홈으로</Button>
      </div>
    </div>
  </section>
</BaseLayout>
