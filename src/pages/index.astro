---
import BaseLayout from "../layouts/BaseLayout.astro";
import MetricRail from "../components/MetricRail.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getProjects } from "../lib/projects";

const projects = await getProjects();
const hajaCheck = projects.find((project) => project.id === "hajacheck");
const mlEconomics = projects.find((project) => project.id === "ml-economics-answers");
const machineLearningOil = projects.find((project) => project.id === "machine-learning-oil");
const selectedProjects = [mlEconomics, machineLearningOil].filter(
  (project): project is NonNullable<typeof project> => Boolean(project)
);

const impactMetrics = [
  { value: "1년 4개월", label: "웹 개발 실무", scope: "personal" as const, evidence: "공개 이력서 경력 기간" },
  { value: "30분 이상", label: "인증 업무 건당 단축", scope: "personal" as const, evidence: "기존 수작업 대비 업무 기록" },
  { value: "약 20%", label: "AVAS 조회 응답 개선", scope: "personal" as const, evidence: "약 2.0초에서 1.6초로 측정" }
];
---

<BaseLayout>
  <section class="page-shell hero hero--project" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">AI connected full stack developer</p>
      <h1 id="hero-title"><span class="line-unit">검증 가능한</span> AI를 <em>서비스로</em> 연결합니다.</h1>
      <p class="hero-lead">모델 성능을 다시 확인하고, 화면과 API와 데이터베이스가 끊기지 않는 제품 흐름을 만듭니다.</p>
      {hajaCheck && (
        <div class="hero-actions">
          <a class="button" href={`/projects/${hajaCheck.id}/`}>HajaCheck 사례 보기</a>
          <a class="button button--ghost" href="/resume/">이력서</a>
        </div>
      )}
    </div>

    {hajaCheck && (
      <aside class="hero-evidence" aria-labelledby="hero-evidence-title">
        <header class="hero-evidence__head">
          <p>Featured case <span>01</span></p>
          <h2 id="hero-evidence-title">{hajaCheck.data.displayTitle}</h2>
          <small>{hajaCheck.data.category} / 팀 프로젝트</small>
        </header>

        <dl class="hero-evidence__scope">
          <div>
            <dt>My scope</dt>
            <dd>DB·API 계약, 하자 관리, 통계</dd>
          </div>
          <div>
            <dt>Flyway</dt>
            <dd><strong>8</strong>건</dd>
          </div>
          <div>
            <dt>Merged PR</dt>
            <dd><strong>66</strong>건</dd>
          </div>
        </dl>

        <div class="hero-evidence__flow" aria-label="HajaCheck 서비스 처리 흐름">
          <p>Service flow</p>
          <ol>
            <li>사진</li>
            <li>AI 분석</li>
            <li>사람 검수</li>
            <li>보고서</li>
          </ol>
        </div>
      </aside>
    )}
  </section>

  <section class="section" aria-labelledby="impact-title">
    <div class="page-shell">
      <div class="section-head" data-reveal>
        <p class="section-index">01 / 실무 성과</p>
        <div>
          <h2 id="impact-title">업무 시간을 줄이고 <span class="line-unit-wide"><span class="line-unit">응답 흐름을</span> <span class="line-unit">다듬었습니다.</span></span></h2>
          <p>성과는 비교 기준과 측정 맥락이 있는 값만 공개합니다.</p>
        </div>
      </div>
      <MetricRail metrics={impactMetrics} />
      <a class="text-link impact-link" href="/resume/#experience">공개 이력서에서 측정 맥락 확인 <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section" id="featured" aria-labelledby="featured-title">
    <div class="page-shell">
      <div class="section-head" data-reveal>
        <p class="section-index">02 / 대표 사례</p>
        <div>
          <h2 id="featured-title">구현보다 먼저 <span class="line-unit">검증 기준을 세웁니다.</span></h2>
        </div>
      </div>
      <div class="featured-grid featured-grid--pair">
        {selectedProjects.map((project, index) => (
          <ProjectCard project={project} variant={index === 0 ? "wide" : "standard"} />
        ))}
      </div>
      <a class="button button--ghost section-action" href="/projects/">전체 프로젝트</a>
    </div>
  </section>

  <section class="section" aria-labelledby="principles-title">
    <div class="page-shell">
      <div class="section-head" data-reveal>
        <p class="section-index">03 / 일하는 방식</p>
        <div>
          <h2 id="principles-title">결과를 믿을 수 있는 <span class="line-unit">구조를 만듭니다.</span></h2>
        </div>
      </div>
      <div class="principles" data-reveal>
        <article class="principle">
          <strong>01</strong>
          <h3>누수를 <span class="line-unit">먼저 의심합니다</span></h3>
          <p>좋은 점수보다 데이터 분할과 실제 입력 조건을 먼저 확인합니다.</p>
        </article>
        <article class="principle">
          <strong>02</strong>
          <h3>LLM의 <span class="line-unit">책임을 제한합니다</span></h3>
          <p>의도는 모델이 구조화하고, 권한과 정합성은 서버가 보장하게 나눕니다.</p>
        </article>
        <article class="principle">
          <strong>03</strong>
          <h3>계약을 <span class="line-unit">코드로 남깁니다</span></h3>
          <p>화면, API, 데이터베이스의 변경 경계를 명확히 관리합니다.</p>
        </article>
      </div>
      <div class="hero-actions portfolio-actions" data-reveal>
        <a class="button" href="/resume/resume.pdf">PDF 이력서</a>
        <a class="button button--ghost" href="https://github.com/Polalise" target="_blank" rel="noreferrer">GitHub</a>
        <a class="button button--ghost" href="mailto:qudgus182@naver.com">이메일</a>
      </div>
    </div>
  </section>
</BaseLayout>
