---
import BaseLayout from "../layouts/BaseLayout.astro";
import MetricRail from "../components/MetricRail.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getProjects } from "../lib/projects";
import { projectVisualMedia } from "../lib/media";

const projects = await getProjects();
const byId = (id: string) => projects.find((project) => project.id === id);

const hajaCheck = byId("hajacheck");
const mlEconomics = byId("ml-economics-answers");
const machineLearningOil = byId("machine-learning-oil");
const selectedProjects = [mlEconomics, machineLearningOil].filter(
  (project): project is NonNullable<typeof project> => Boolean(project)
);
const otherProjects = projects.filter(
  (project) => !["hajacheck", "ml-economics-answers", "machine-learning-oil"].includes(project.id)
);

const impactMetrics = [
  { value: "1년 4개월", label: "웹 개발 실무", scope: "personal" as const, evidence: "공개 이력서 경력 기간" },
  { value: "30분 이상", label: "인증 업무 건당 단축", scope: "personal" as const, evidence: "기존 수작업 대비 업무 기록" },
  { value: "약 20%", label: "AVAS 조회 응답 개선", scope: "personal" as const, evidence: "약 2.0초에서 1.6초로 측정" }
];

// 탐색기 항목은 실제 프로젝트 콘텐츠에서만 만든다. 미리보기 이미지는 상세 갤러리와 같은
// 생성물을 재사용하므로 새 에셋을 만들지 않는다. 근거: 루트 디자인 설계 노트 11.8 절
type ExplorerEntry = {
  id: string;
  index: string;
  title: string;
  subtitle: string;
  description: string;
  facts: { label: string; value: string }[];
  stack: string[];
  href: string;
  hrefLabel: string;
  media?: ReturnType<typeof projectVisualMedia>;
  mediaAlt?: string;
  mediaCaption?: string;
  list?: { title: string; category: string }[];
};

const explorerEntries: ExplorerEntry[] = [];

// 상세 갤러리는 첫 항목을 전체 폭으로 렌더링하므로 그 순서와 홈의 대표 화면 선택을 분리한다.
// 홈은 id 로 고르고, 지정이 없으면 첫 화면으로 되돌아간다.
const FEATURED_VISUAL_ID: Record<string, string> = { hajacheck: "app-dashboard" };
const featuredVisual = (project: (typeof projects)[number]) =>
  project.data.visuals.find(({ id }) => id === FEATURED_VISUAL_ID[project.id]) ?? project.data.visuals[0];

for (const [offset, project] of [hajaCheck, mlEconomics, machineLearningOil].entries()) {
  if (!project) continue;
  const visual = featuredVisual(project);
  explorerEntries.push({
    id: project.id,
    index: String(offset + 1).padStart(2, "0"),
    title: project.data.displayTitle,
    subtitle: project.data.category,
    description: project.data.summary,
    facts: [
      { label: "Role", value: project.data.role ?? "개인 프로젝트" },
      { label: "Period", value: project.data.period ?? "미기재" },
      { label: "Team", value: !project.data.teamSize || project.data.teamSize === 1 ? "개인" : `${project.data.teamSize}명` }
    ],
    stack: project.data.technologies.slice(0, 5),
    href: `/projects/${project.id}/`,
    hrefLabel: `${project.data.displayTitle} 사례 자세히 보기`,
    media: visual ? projectVisualMedia(project.id, visual.id) : undefined,
    mediaAlt: visual?.alt,
    mediaCaption: visual?.caption
  });
}

explorerEntries.push({
  id: "other-works",
  index: "04",
  title: "Other Works",
  subtitle: "학습 과제와 팀 프로젝트",
  description: "수면 예측과 사내 업무 플랫폼, 초기 학습용 웹 프로젝트를 포함한 나머지 기록입니다. 각 항목에도 담당 범위와 한계를 함께 적었습니다.",
  facts: [
    { label: "Projects", value: `${otherProjects.length}건` },
    { label: "Scope", value: "개인과 팀 구분 표기" },
    { label: "Evidence", value: "화면과 지표 근거 포함" }
  ],
  stack: [],
  href: "/projects/",
  hrefLabel: "전체 프로젝트 목록 보기",
  list: otherProjects.map((project) => ({
    title: project.data.displayTitle,
    category: project.data.category
  }))
});

const heroEntry = explorerEntries[0];
const caseVisual = hajaCheck?.data.visuals.find(({ id }) => id === "app-analysis-viewer");
const caseMedia = caseVisual ? projectVisualMedia("hajacheck", caseVisual.id) : undefined;

const principles = [
  { index: "01", title: "누수를 먼저 의심합니다", body: "좋은 점수보다 데이터 분할과 실제 입력 조건을 먼저 확인합니다.", icon: "search" },
  { index: "02", title: "LLM의 책임을 제한합니다", body: "의도는 모델이 구조화하고, 권한과 정합성은 서버가 보장하게 나눕니다.", icon: "shield" },
  { index: "03", title: "계약을 코드로 남깁니다", body: "화면과 API, 데이터베이스의 변경 경계를 명확히 관리합니다.", icon: "code" }
];
---

<BaseLayout>
  <section class="d2-hero" aria-labelledby="hero-title">
    <div class="page-shell d2-hero__inner">
      <div class="d2-hero__copy">
        <p class="eyebrow">AI connected full stack developer</p>
        <h1 id="hero-title"><span class="d2-line">화면부터 DB와 AI까지</span> <span class="d2-line">직접 설계합니다<span class="d2-dot">.</span></span></h1>
        <p class="d2-hero__lead">
          프론트엔드와 API, 데이터베이스 스키마와 AI 연동까지 같은 기준으로 설계하고 검증합니다.
        </p>
        <div class="d2-hero__actions">
          <a class="button" href="#work">프로젝트 보기 <span aria-hidden="true">↓</span></a>
          <a class="button button--ghost" href="/resume/">이력서 <span aria-hidden="true">→</span></a>
        </div>
      </div>

      {heroEntry?.media && (
        <figure class="d2-preview d2-hero__preview">
          <img
            src={heroEntry.media.src}
            srcset={heroEntry.media.srcset}
            sizes="(max-width: 64rem) calc(100vw - 2.3rem), 56vw"
            width={heroEntry.media.width}
            height={heroEntry.media.height}
            alt={heroEntry.mediaAlt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption><span>Featured</span>{heroEntry.title} · {heroEntry.mediaCaption}</figcaption>
        </figure>
      )}

      <MetricRail metrics={impactMetrics} />
    </div>
  </section>

  <section class="section d2-section" id="work" aria-labelledby="work-title">
    <div class="page-shell">
      <div class="d2-section__head" data-reveal>
        <p class="section-index">01 / Selected projects</p>
        <h2 id="work-title">프로젝트를 골라 바로 확인하세요</h2>
        <p>각 항목은 실제 화면과 담당 범위, 검증 근거를 함께 보여줍니다.</p>
      </div>

      <div class="d2-explorer">
        <div class="d2-explorer__index" role="tablist" aria-orientation="vertical" aria-label="프로젝트 선택">
          {explorerEntries.map((entry, index) => (
            <button
              type="button"
              role="tab"
              id={`explorer-tab-${entry.id}`}
              class="d2-explorer__item"
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`explorer-panel-${entry.id}`}
              tabindex={index === 0 ? 0 : -1}
            >
              <span class="d2-explorer__num">{entry.index}</span>
              <span class="d2-explorer__name">
                <strong>{entry.title}</strong>
                <small>{entry.subtitle}</small>
              </span>
              <span class="d2-explorer__arrow" aria-hidden="true">→</span>
            </button>
          ))}
        </div>

        <div class="d2-explorer__stage">
          {explorerEntries.map((entry, index) => (
            <div
              role="tabpanel"
              id={`explorer-panel-${entry.id}`}
              class="d2-panel"
              aria-labelledby={`explorer-tab-${entry.id}`}
              hidden={index !== 0}
            >
              <div class="d2-panel__body">
                <p class="d2-panel__kicker">{entry.index} / {entry.subtitle}</p>
                <h3>{entry.title}</h3>
                <p class="d2-panel__lead">{entry.description}</p>

                <dl class="d2-panel__facts">
                  {entry.facts.map((fact) => (
                    <div>
                      <dt>{fact.label}</dt>
                      <dd>{fact.value}</dd>
                    </div>
                  ))}
                </dl>

                {entry.stack.length > 0 && (
                  <ul class="d2-tags" aria-label={`${entry.title} 주요 기술`}>
                    {entry.stack.map((item) => <li>{item}</li>)}
                  </ul>
                )}

                {entry.list && (
                  <ul class="d2-panel__list">
                    {entry.list.map((item) => (
                      <li><strong>{item.title}</strong><span>{item.category}</span></li>
                    ))}
                  </ul>
                )}

                <a class="text-link" href={entry.href} aria-label={entry.hrefLabel}>
                  {entry.list ? "전체 프로젝트" : "사례 자세히 보기"} <span aria-hidden="true">→</span>
                </a>
              </div>

              {entry.media && (
                <figure class="d2-preview d2-panel__media">
                  <img
                    src={entry.media.src}
                    srcset={entry.media.srcset}
                    sizes="(max-width: 64rem) calc(100vw - 2.3rem), 40vw"
                    width={entry.media.width}
                    height={entry.media.height}
                    alt={entry.mediaAlt}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{entry.mediaCaption}</figcaption>
                </figure>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {hajaCheck && (
    <section class="section d2-section" id="featured" aria-labelledby="case-title">
      <div class="page-shell">
        <div class="d2-case">
          {caseMedia && (
            <figure class="d2-preview d2-case__media" data-reveal>
              <img
                src={caseMedia.src}
                srcset={caseMedia.srcset}
                sizes="(max-width: 64rem) calc(100vw - 2.3rem), 48vw"
                width={caseMedia.width}
                height={caseMedia.height}
                alt={caseVisual?.alt}
                loading="lazy"
                decoding="async"
              />
              <figcaption>{caseVisual?.caption}</figcaption>
            </figure>
          )}

          <div class="d2-case__body" data-reveal>
            <p class="section-index">02 / Case study</p>
            <h2 id="case-title">{hajaCheck.data.displayTitle}</h2>
            <p class="d2-case__lead">{hajaCheck.data.summary}</p>

            <div class="d2-case__split">
              <div>
                <h3>Problem</h3>
                <p>{hajaCheck.data.problem}</p>
              </div>
              <div>
                <h3>My scope</h3>
                <p>{hajaCheck.data.role}</p>
              </div>
            </div>

            <p class="d2-case__limit">{hajaCheck.data.limitation}</p>
            <a class="text-link" href="/projects/hajacheck/">HajaCheck 사례 보기 <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <MetricRail metrics={hajaCheck.data.metrics} />
      </div>
    </section>
  )}

  <section class="section d2-section" aria-labelledby="selected-title">
    <div class="page-shell">
      <div class="d2-section__head" data-reveal>
        <p class="section-index">03 / Selected works</p>
        <h2 id="selected-title">구현보다 먼저 검증 기준을 세웁니다</h2>
      </div>
      <div class="featured-grid featured-grid--pair">
        {selectedProjects.map((project) => (
          <ProjectCard project={project} variant="standard" />
        ))}
      </div>
    </div>
  </section>

  <section class="section d2-section" id="about" aria-labelledby="principles-title">
    <div class="page-shell">
      <div class="d2-section__head" data-reveal>
        <p class="section-index">04 / How I work</p>
        <h2 id="principles-title">결과를 믿을 수 있는 구조를 만듭니다</h2>
      </div>
      <div class="d2-principles" data-reveal>
        {principles.map((principle) => (
          <article class="d2-principle">
            <span class="d2-principle__num">{principle.index}</span>
            <span class="d2-principle__icon" aria-hidden="true">
              {principle.icon === "search" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" />
                </svg>
              )}
              {principle.icon === "shield" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3 5 6v5.5c0 4.3 2.9 7.6 7 9.5 4.1-1.9 7-5.2 7-9.5V6z" /><path d="m9 12 2 2 4-4" />
                </svg>
              )}
              {principle.icon === "code" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m8 7-5 5 5 5" /><path d="m16 7 5 5-5 5" /><path d="M13.5 4 10.5 20" />
                </svg>
              )}
            </span>
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section d2-section" id="contact" aria-labelledby="contact-title">
    <div class="page-shell">
      <div class="d2-contact" data-reveal>
        <div class="d2-contact__identity">
          <p class="d2-contact__pill">함께 만들어봅시다</p>
          <h2 id="contact-title">유병현</h2>
          <p class="d2-contact__role">AI 연동형 풀스택 개발자</p>
        </div>
        <div class="d2-contact__actions">
          <a class="button" href="https://github.com/Polalise" target="_blank" rel="noreferrer">GitHub</a>
          <a class="button button--ghost" href="mailto:qudgus182@naver.com">이메일</a>
          <a class="button button--ghost" href="/resume/resume.pdf">PDF 이력서</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const list = document.querySelector<HTMLElement>(".d2-explorer__index");
  if (list) {
    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));

    const select = (next: number, focus: boolean) => {
      tabs.forEach((tab, index) => {
        const selected = index === next;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = !selected;
      });
      if (focus) tabs[next]?.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index, false));
      tab.addEventListener("keydown", (event) => {
        const moves: Record<string, number> = {
          ArrowDown: index + 1,
          ArrowRight: index + 1,
          ArrowUp: index - 1,
          ArrowLeft: index - 1,
          Home: 0,
          End: tabs.length - 1
        };
        const target = moves[event.key];
        if (target === undefined) return;
        event.preventDefault();
        select((target + tabs.length) % tabs.length, true);
      });
    });
  }
</script>
