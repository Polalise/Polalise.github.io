{
  "name": "polalise-github-pages",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "npm run media:check && npm run check && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/audit-public.mjs",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "resume:build": "node scripts/build_resume.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:lighthouse": "npm run build && node scripts/lighthouse-check.mjs",
    "font:characters": "node scripts/collect-font-characters.mjs",
    "audit": "node scripts/audit-public.mjs",
    "media:build": "node scripts/project-media.mjs --build",
    "media:check": "node scripts/project-media.mjs --check"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.1.6",
    "pretendard": "1.3.9",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.1",
    "cross-env": "10.1.0",
    "lighthouse": "13.4.1",
    "pdfjs-dist": "6.2.108",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=24"
  }
}
